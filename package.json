  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "minimist": "^1.2.8",
    "rimraf": "^6.1.3",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.105.2",
    "siyuan": "1.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }

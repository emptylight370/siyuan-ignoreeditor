{
  "name": "siyuan-ignoreeditor",
  "version": "0.0.1",
  "type": "module",
  "description": "This is a plugin that edit ignore files",
  "author": "Emptylight",
  "license": "MIT",
  "homepage": "https://github.com/emptylight370/siyuan-ignoreeditor",
  "repository": "https://github.com/emptylight370/siyuan-ignoreeditor",
  "scripts": {
    "dev": "vite build --watch",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "build": "vite build",
    "clean": "rimraf dist package.zip dev"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    },
    "packageManager": {
